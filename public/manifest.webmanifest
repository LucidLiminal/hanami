{
  "id": "/",
  "name": "Hanami — lector web",
  "short_name": "Hanami",
  "description": "Lector web nocturno y personal con biblioteca, progreso y extensiones JavaScript.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#09080b",
  "theme_color": "#09080b",
  "lang": "es",
  "categories": [
    "books",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/assets/hanami-pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/hanami-pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/hanami-pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Biblioteca",
      "short_name": "Biblioteca",
      "url": "/library",
      "icons": [
        {
          "src": "/assets/hanami-pwa-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Buscar",
      "short_name": "Buscar",
      "url": "/search",
      "icons": [
        {
          "src": "/assets/hanami-pwa-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Extensiones",
      "short_name": "Extensiones",
      "url": "/extensions",
      "icons": [
        {
          "src": "/assets/hanami-pwa-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Descargas",
      "short_name": "Descargas",
      "url": "/downloads",
      "icons": [
        {
          "src": "/assets/hanami-pwa-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/search",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "q",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+hanami",
      "url": "/search?q=%s"
    }
  ]
}
