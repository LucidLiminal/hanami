# Optional: your own HTTPS NewPipe/yt-dlp-compatible resolver.
# Hanami POSTs {"videoId":"..."}; see READER_MUSIC_SERVICES_V129.md.
HANAMI_YOUTUBE_RESOLVER_URL=

# Optional bearer token sent only by the serverless function.
HANAMI_YOUTUBE_RESOLVER_TOKEN=

# Required in production to enable the user-selected Invidious fallback relay.
# Comma-separated exact HTTPS origins; no paths or trailing endpoints.
HANAMI_INVIDIOUS_ALLOWED_ORIGINS=
